# Copy to .env and adjust. Every value has a working default, so an empty .env still runs.

# --- Upstream provider -------------------------------------------------------------
# Defaults to the bundled mock provider so the stack runs with no third-party account.
# For real data, sign up at https://www.api-football.com/ and use:
#   UPSTREAM_BASE_URL=https://v3.football.api-sports.io
#   UPSTREAM_API_KEY=<your key>
UPSTREAM_BASE_URL=http://mock-upstream:8081
UPSTREAM_API_KEY=
UPSTREAM_API_KEY_HEADER=x-apisports-key
UPSTREAM_TIMEOUT_MS=4000

# --- Caching -----------------------------------------------------------------------
# CACHE_ENABLED=false is the no-cache baseline used by scripts/benchmark.sh.
CACHE_ENABLED=true
CACHE_TTL_SCORES_S=10
CACHE_TTL_FIXTURES_S=300
CACHE_TTL_PLAYERS_S=3600
CACHE_TTL_FINISHED_S=21600
CACHE_FALLBACK_TTL_S=3600
CACHE_SWR_ENABLED=true
CACHE_SWR_WINDOW_S=30
CACHE_NEGATIVE_TTL_S=30

# --- Rate limiting -----------------------------------------------------------------
# Inbound is per client (API key, else IP). Outbound is one global bucket shared by
# every gateway instance and should mirror the provider's published quota.
RL_INBOUND_ENABLED=true
RL_INBOUND_CAPACITY=600
RL_INBOUND_REFILL_PER_SEC=200
RL_OUTBOUND_ENABLED=true
RL_OUTBOUND_CAPACITY=100
RL_OUTBOUND_REFILL_PER_SEC=1.6

# --- Circuit breaker ---------------------------------------------------------------
BREAKER_ENABLED=true
BREAKER_TIMEOUT_MS=4500
BREAKER_ERROR_THRESHOLD_PCT=50
BREAKER_RESET_TIMEOUT_MS=10000
BREAKER_VOLUME_THRESHOLD=5

# --- Analytics ---------------------------------------------------------------------
ANALYTICS_ENABLED=true
ANALYTICS_SAMPLE_RATE=1
ANALYTICS_RETENTION_DAYS=7

# --- Runtime -----------------------------------------------------------------------
LOG_LEVEL=info
GATEWAY_REPLICAS=2
GATEWAY_PORT=8080
GRAFANA_PORT=3001
PROMETHEUS_PORT=9090
MOCK_PORT=8081
# Required header on /admin/* routes: x-admin-token: <value>. docker-compose.yml falls
# back to a published demo-only value if this is left blank — change it for anything
# beyond a local demo. Running `node src/index.js` directly with no .env leaves it
# genuinely unset, which is the same "open" behavior this project has always had outside
# Docker Compose.
ADMIN_TOKEN=

# '*' is fine for this API: every route is public, read-only sports data with no cookies
# or bearer auth, so there's no cross-origin credential to protect. Restrict it to a
# comma-separated allowlist if you don't want arbitrary origins reading responses.
CORS_ORIGIN=*
