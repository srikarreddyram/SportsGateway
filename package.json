{
  "name": "sportsgateway",
  "version": "1.0.0",
  "private": true,
  "description": "Distributed API gateway and caching layer for sports data services",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node src/index.js",
    "start:worker": "node src/worker.js",
    "dev": "node --watch src/index.js",
    "mock": "node mock-upstream/server.js",
    "test": "LOG_LEVEL=silent node --test \"test/**/*.test.js\"",
    "test:coverage": "LOG_LEVEL=silent node --experimental-test-coverage --test-reporter=spec --test-reporter-destination=stdout --test-coverage-exclude=\"test/**\" --test-coverage-exclude=\"scripts/**\" --test \"test/**/*.test.js\"",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "benchmark": "./scripts/benchmark.sh",
    "benchmark:scaling": "./scripts/scaling.sh",
    "benchmark:local": "node scripts/local-benchmark.mjs",
    "benchmark:failure": "./scripts/failure.sh"
  },
  "dependencies": {
    "bullmq": "^6.1.2",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "helmet": "^8.3.0",
    "ioredis": "^6.0.0",
    "js-yaml": "^5.3.0",
    "mongodb": "^7.5.0",
    "opossum": "^10.0.0",
    "pino": "^10.3.1",
    "prom-client": "^15.1.3",
    "swagger-ui-express": "^5.0.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.11.0",
    "pino-pretty": "^13.1.3",
    "prettier": "^3.9.6"
  }
}
