{
  "name": "sportsgateway-web",
  "version": "1.0.0",
  "private": true,
  "description": "Companion UI for SportsGateway — consumes the public gateway API like any other client.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
